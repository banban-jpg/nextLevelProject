<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="concertDetail.mapper.ConcertDetailMapper">
    <resultMap id="concertDetailResultMap" type="ConcertDetailDTO">
        <id property="id" column="ID"/>
        <result property="title" column="TITLE"/>
        <result property="performanceDate" column="PERFORMANCE_DATE"/>
        <result property="bookingDate" column="BOOKING_DATE"/>
        <result property="location" column="LOCATION"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="artistName" column="ARTIST_NAME"/>
        <result property="genre" column="GENRE"/>
        <collection property="sessions" ofType="ConcertSessionDTO">
            <id property="sessionId" column="SESSION_ID"/>
            <result property="startTime" column="START_TIME"/>
        </collection>
    </resultMap>

    <select id="selectConcertDetail" parameterType="int" resultMap="concertDetailResultMap">
        SELECT c.CONCERT_ID AS ID,
               c.TITLE,
               c.DESCRIPTION,
               c.ARTIST_NAME,
               c.GENRE,
               TO_CHAR(c.BOOKING_OPEN_AT, 'YYYY.MM.DD HH24:MI') AS BOOKING_DATE,
               v.NAME AS LOCATION,
               cs.SESSION_ID,
               TO_CHAR(cs.START_TIME, 'YYYY.MM.DD HH24:MI') AS START_TIME
        FROM CONCERT c
        JOIN VENUE v ON c.VENUE_ID = v.VENUE_ID
        LEFT JOIN CONCERT_SESSION cs ON c.CONCERT_ID = cs.CONCERT_ID
        WHERE c.CONCERT_ID = #{concertId}
        ORDER BY cs.START_TIME ASC
    </select>
</mapper>
